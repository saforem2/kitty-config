#!/usr/bin/env zsh
# Regenerate missing.conf: every kitty option NOT set anywhere in this config,
# rendered commented-out with its default value and kitty's own help text.
#
# Reads the option list from the RUNNING kitty binary
# (kitty.options.definition), so it can never drift from the installed version
# the way a hand-maintained list does. Re-run after upgrading kitty.
#
#   ./gen-missing-conf
set -euo pipefail
cd "${0:a:h}"

py=$(mktemp -t genmissing.XXXXXX.py)
trap 'rm -f "$py"' EXIT

cat > "$py" <<'PY'
import os, re
from kitty.options.definition import definition
from kitty.constants import str_version

CFGDIR = os.path.expanduser("~/.config/kitty")

all_opts = {}
for o in definition.iter_all_non_groups():
    if hasattr(o, "name") and hasattr(o, "defval_as_string"):
        all_opts[o.name] = o

# Walk the include graph exactly as kitty does (relative to each file's dir).
seen, files = set(), []
stack = [os.path.join(CFGDIR, "kitty.conf")]
while stack:
    p = os.path.realpath(stack.pop(0))
    if p in seen or not os.path.exists(p):
        continue
    seen.add(p); files.append(p)
    d = os.path.dirname(p)
    for line in open(p, errors="replace"):
        m = re.match(r"^(?:globinclude|geninclude|envinclude|include)\s+(.+)$", line.strip())
        if m:
            stack.append(os.path.join(d, m.group(1).strip()))

setopts = set()
for f in files:
    for line in open(f, errors="replace"):
        s = line.strip()
        if s and not s.startswith("#"):
            k = s.split(None, 1)[0]
            if k in all_opts:
                setopts.add(k)

# color16-255 are bulk palette entries owned by the theme files.
bulk = re.compile(r"color(1[6-9]|[2-9]\d|1\d\d|2[0-4]\d|25[0-5])$")
rows = []
for name, o in all_opts.items():
    if name in setopts or bulk.fullmatch(name):
        continue
    grp = getattr(o, "group", None)
    rows.append((str(getattr(grp, "title", None) or getattr(grp, "name", "?")), o))

order, s2 = [], set()
for g, _ in rows:
    if g not in s2:
        s2.add(g); order.append(g)

out = [
 "# vim:ft=kitty:fileencoding=utf-8:foldmethod=marker",
 "#",
 "# missing.conf — kitty options NOT set anywhere in this config.",
 "#",
 "# GENERATED by ./gen-missing-conf — do not hand-edit; re-run after a",
 "# kitty upgrade. Source of truth is the running binary's",
 "# kitty.options.definition, not the docs, so it cannot drift from the",
 "# installed version the way a hand-maintained list does.",
 "#",
 f"# kitty version : {str_version}",
 f"# options shown : {len(rows)} (unset across " + ", ".join(os.path.basename(f) for f in files) + ")",
 "#",
 "# EVERY line here is commented out and shows kitty's DEFAULT value, so",
 "# including this file changes nothing. Uncomment a line to override it.",
 "# color16-255 are omitted: the theme files set the palette.",
 "",
]
for gname in order:
    items = sorted([o for g, o in rows if g == gname], key=lambda x: x.name)
    out += ["", "#: " + "=" * 68, f"#: {gname}  ({len(items)} unset)", "#: " + "=" * 68, ""]
    for o in items:
        for line in o.as_conf(commented=True):
            s = line.rstrip()
            if not s:
                out.append("")
            elif s.lstrip().startswith("#"):
                out.append(s)
            else:
                out.append("# " + s)   # as_conf emits a LIVE setting line; comment it
        out.append("")

dest = os.path.join(os.path.dirname(os.path.realpath(os.path.join(CFGDIR, "kitty.conf"))), "missing.conf")
open(dest, "w").write("\n".join(out) + "\n")
print(f"wrote {dest}: {len(rows)} options, kitty {str_version}")
PY

kitty +runpy "$(cat "$py")"

# Fail loudly if any line would actually SET something.
if active=$(grep -vE '^\s*(#|$)' missing.conf); then
  print -u2 "ERROR: missing.conf contains active settings:"
  print -u2 "$active"
  exit 1
fi
print "verified: 0 active lines ($(grep -cE '^# [a-z_0-9]+ ' missing.conf) options documented)"
