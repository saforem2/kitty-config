#!/usr/bin/env python3
"""Rewrite herdr's mode-specific custom themes to mirror kitty light/dark.

Usage: herdr-theme [{dark|light}] [--config PATH] [--print]

herdr accepts hex / named / rgb() colors only, but the kitty themes are
authored in OKLCH -- conversion and the contrast helpers live in
kitty_colors.py, shared with leaf-theme.

Both palettes are written as [theme.custom.light] and [theme.custom.dark].
The [theme] selector is normalized to an auto-switching terminal base, then
Herdr selects the right override directly from terminal appearance, without
needing a config rewrite when macOS changes appearance. Every unrelated line
is preserved because config.toml also holds keybindings and plugin settings.

The 16 token names below are herdr's CustomThemeColors fields. They are
Catppuccin-flavoured; a token not in this list is silently ignored by herdr
(its config check does not validate them), so do not invent new ones.
"""

import argparse
import os
import re
import sys

# realpath: this script is also symlinked into ~/.config/kitty, and abspath
# would not resolve that, leaving kitty_colors unimportable from the link.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from kitty_colors import (  # noqa: E402
    at_contrast, contrast, deepen, hex_to_oklch, legible as _legible, _lum,
    load_kitty_theme, mix, oklch_to_hex,
)

# Optional per-machine sidebar tint. Set HERDR_SIDEBAR_TINT to one of these
# names (or any hex) to nudge sidebar_bg toward that hue, so two machines
# running the same kitty theme are still tellable apart at a glance. Unset =
# the neutral, purely contrast-derived sidebar (the historical behaviour).
# The value `accent` is special: it follows the resolved kitty accent per mode
# rather than a fixed hue -- see _tinted_sidebar for the trade-off.
# The tint is applied AFTER the 1.06 contrast step and is deliberately weak,
# so the sidebar still reads as chrome rather than as a coloured panel.
SIDEBAR_TINTS = {
    "amber":  "#ff9d00",
    "teal":   "#00b3a4",
    "violet": "#8260cc",
    "rose":   "#db2587",
    "green":  "#1e8759",
    "blue":   "#327abc",
    # sky is a lighter, greener blue than `blue`. Against `violet` it is the
    # one that reads clearly different: violet leaves G just below R, sky
    # pushes G well above it, so the G-vs-R relationship flips rather than
    # both just looking "cool".
    "sky":    "#3fa9f5",
    # mint is a light, slightly cool green. Against `violet` it is the
    # strongest pairing available here: violet keeps B above G, mint pushes G
    # above B, so the blue-vs-green relationship inverts rather than the two
    # merely differing in lightness.
    "mint":   "#3ddc97",
}
# How far sidebar_bg is mixed toward the tint hue. Overridable per machine with
# HERDR_SIDEBAR_TINT_STRENGTH so two tinted hosts can differ in intensity as
# well as hue. Above ~0.2 the sidebar stops reading as chrome.
SIDEBAR_TINT_STRENGTH = 0.10

# The active row is a focus cue rather than chrome, so it takes the hue much
# more strongly than the sidebar does.
ACCENT_TINT_STRENGTH = 0.65

# Minimum OKLCH chroma for active_border_color to count as a usable accent.
# The dark theme sets active_border_color #FFFFFF (chroma 0.000), so inheriting
# it literally gives an achromatic accent: the focus cue degrades to
# brightness-only and _tinted_surface has no hue to apply, leaving the active
# row flat grey. Below this floor we fall back to ACCENT_FALLBACK_ROLES.
# 0.02 rather than exactly 0: near-grey values have an unstable hue angle, so
# using one would produce an arbitrary tint.
ACCENT_MIN_CHROMA = 0.02

# Ordered fallbacks when active_border_color is achromatic. color3 first
# because both themes make it their most saturated high-contrast role; color5
# and color2 follow so a theme that leaves color3 grey still resolves.
ACCENT_FALLBACK_ROLES = ["color3", "color5", "color2", "color6"]
# Fraction of the accent's chroma the active-row fill keeps. The row is a
# wash behind text, so it takes the hue at low saturation; lightness comes
# from the contrast-derived base, not from the accent.
SURFACE1_CHROMA = 0.30


# Shared tint settings live beside this script, not just in the environment.
#
# sync-theme calls this script from Hammerspoon on every macOS appearance
# change, via os.execute -- no login shell, so nothing exported from
# ~/.zshrc.local is visible and the tint silently reverted on the next
# light/dark switch. Keep the source of truth in the kitty-config repo so mbph
# and mbpr get the same treatment after a pull; environment variables remain
# available for one-off overrides.
#
# Format: one KEY=value per line, '#' comments allowed. Keys are the same as
# the env vars, without the HERDR_ prefix:
#     SIDEBAR_TINT=mint
#     SIDEBAR_TINT_STRENGTH=0.10
#     ACCENT_TINT=#1aa912
TINT_CONF = os.path.join(os.path.dirname(os.path.realpath(__file__)), "herdr-tint.conf")


def _tint_setting(key):
    """Env var HERDR_<key> wins; otherwise use the shared repo config."""
    val = os.environ.get("HERDR_" + key, "").strip()
    if val:
        return val
    try:
        with open(TINT_CONF, encoding="utf-8") as fh:
            for line in fh:
                # Split on '=' FIRST: a value may legitimately start with
                # '#' (a hex colour), so stripping comments before the split
                # would silently truncate ACCENT_TINT=#1aa912 to nothing.
                if "=" not in line:
                    continue
                k, _, v = line.partition("=")
                if k.strip().lstrip("#") != k.strip():
                    continue  # the whole line was a comment
                if k.strip() != key:
                    continue
                v = v.strip()
                # A trailing comment is only a comment when it follows
                # whitespace, so '#1aa912  # note' keeps the colour.
                if " #" in v:
                    v = v.split(" #", 1)[0].strip()
                return v.strip('"').strip("'")
    except OSError:
        pass
    return ""


def _tinted_surface(base, bg, hue):
    """Tint the active-row fill (surface1) toward `hue`, weakly.

    Kept far below the accent strength: surface1 must stay clearly dimmer than
    accent, or the active row competes with the border for attention.

    `hue` is the resolved accent (kitty-derived, or the ACCENT_TINT override) --
    passed in rather than re-read from the tint file, so the active row follows
    the accent that is actually in use instead of only a manual override.
    """
    if not hue:
        return base
    # An achromatic accent has no hue to lend; oklch would spin an arbitrary
    # angle out of near-zero chroma, so leave the contrast-derived base alone.
    _, C, H = hex_to_oklch(hue)
    if C < ACCENT_MIN_CHROMA:
        return base

    # Derive this the way CSS would with
    #     oklch(from var(--accent) calc(l * scale) calc(c * scale) h)
    # -- keep the accent's HUE exactly, damp its chroma to a wash, and move
    # only lightness, toward the panel. Blending in sRGB (the previous
    # mix(base, hue, 0.22)) drags the hue through grey and washes the chroma
    # out; deepen()'s docstring documents the same failure for the accent
    # itself, where it cost 72% -> 46% saturation.
    L_base, _, _ = hex_to_oklch(base)
    # Adding chroma at a fixed L raises luminance, which quietly weakened the
    # active/inactive split (1.85 -> 1.51 against the light panel). Walk L back
    # toward the panel until the tinted fill matches the contrast the untinted
    # base had, so the tint changes the HUE and nothing else.
    target = contrast(base, bg)
    darker = _lum(bg) > 0.5
    L = L_base
    for _ in range(120):
        cand = oklch_to_hex(L, C * SURFACE1_CHROMA, H)
        if contrast(cand, bg) >= target:
            return cand
        L += -0.005 if darker else 0.005
        if not 0.0 <= L <= 1.0:
            break
    return oklch_to_hex(max(0.0, min(1.0, L_base)), C * SURFACE1_CHROMA, H)


def _accent_source(k, mode):
    """Resolve the kitty role the accent inherits from, for one mode.

    Normally kitty's active_border_color -- herdr's accent IS the active pane
    border, so that is the honest source. But the dark theme sets it to
    #FFFFFF: inheriting literally yields an achromatic accent, so the focus cue
    becomes brightness-only and the active row loses its tint entirely. When
    the border is below ACCENT_MIN_CHROMA, fall back to the first chromatic
    role in ACCENT_FALLBACK_ROLES.

    Returns (hex, raw, role) -- `raw` is the value as authored, which deepen()
    needs to walk lightness without dragging the hue through grey.
    """
    border = k["active_border_color"]
    _, C, _ = hex_to_oklch(border)
    if C >= ACCENT_MIN_CHROMA:
        return border, k.get("__raw__active_border_color", ""), "active_border_color"

    for role in ACCENT_FALLBACK_ROLES:
        if role not in k:
            continue
        _, c_fb, _ = hex_to_oklch(k[role])
        if c_fb >= ACCENT_MIN_CHROMA:
            return k[role], k.get("__raw__" + role, ""), role

    # Every candidate is grey: a monochrome theme is a legitimate choice, so
    # honour the border rather than inventing a hue.
    return border, k.get("__raw__active_border_color", ""), "active_border_color"


def _tinted_accent(base):
    """Shift accent + the active-row fill toward HERDR_ACCENT_TINT, if set.

    accent is the ACTIVE pane border and is also drawn as text, so the result
    is run back through legible()/deepen() by the caller -- a tint that would
    fall under WCAG AA gets darkened automatically rather than shipped
    unreadable. Stronger than the sidebar tint (the active row is a
    deliberate focus cue, not chrome), but still hue-shift rather than
    replacement, so the theme's own lightness relationships survive.
    """
    raw = _tint_setting("ACCENT_TINT").lower()
    if not raw:
        return base
    hue = SIDEBAR_TINTS.get(raw, raw if re.fullmatch(r"#[0-9a-f]{6}", raw) else None)
    if hue is None:
        sys.exit(
            f"herdr-theme: unknown HERDR_ACCENT_TINT {raw!r}; "
            f"expected a #rrggbb value or one of: {', '.join(sorted(SIDEBAR_TINTS))}"
        )
    # REPLACE rather than mix: the authored accent is pink, and blending pink
    # toward green passes through grey -- at 0.65 that produced a muddy
    # #6d616c with no hue left. The caller runs the result through
    # legible()/deepen(), which darkens it to clear WCAG AA if needed, so
    # handing over the raw hue is safe.
    return hue


def _tinted_sidebar(base, accent):
    """Nudge the derived sidebar_bg toward HERDR_SIDEBAR_TINT, if set.

    The special value `accent` follows the resolved accent instead of a fixed
    hue, so the sidebar tracks the kitty theme per mode rather than staying one
    hard-coded colour across both. That is the difference between a sidebar
    that belongs to the palette and one that merely sits next to it.

    Trade-off worth knowing: a fixed hue exists so two machines running the
    same kitty theme stay tellable apart. `accent` gives that up -- both hosts
    then derive the same sidebar. Keep a named hue on one host if the
    at-a-glance distinction matters more than the match.
    """
    raw = _tint_setting("SIDEBAR_TINT").lower()
    if not raw:
        return base
    if raw == "accent":
        # An achromatic accent has no hue to lend, and mixing toward a grey
        # would just dim the sidebar rather than tint it. _accent_source
        # already falls back to a chromatic role, so reaching here means the
        # whole theme is monochrome -- honour that instead of inventing a hue.
        L_acc, c_accent, H_acc = hex_to_oklch(accent)
        if c_accent < ACCENT_MIN_CHROMA:
            return base
        # Mix toward the accent's HUE at the sidebar's own lightness, not
        # toward the accent colour itself. Mixing toward the colour drags
        # lightness with it: dark's accent is #ffff00 (L 0.97), which lifted
        # sidebar_bg until active_row_bg sat only 1.02 above it and the focused
        # row effectively vanished. Re-anchoring L keeps the contrast ladder
        # that at_contrast() established and lets the tint move hue alone.
        L_base, _, _ = hex_to_oklch(base)
        hue = oklch_to_hex(L_base, c_accent, H_acc)
    else:
        hue = SIDEBAR_TINTS.get(raw, raw if re.fullmatch(r"#[0-9a-f]{6}", raw) else None)
    if hue is None:
        sys.exit(
            f"herdr-theme: unknown HERDR_SIDEBAR_TINT {raw!r}; expected 'accent', "
            f"a #rrggbb value, or one of: {', '.join(sorted(SIDEBAR_TINTS))}"
        )
    raw_strength = _tint_setting("SIDEBAR_TINT_STRENGTH")
    if raw_strength:
        try:
            strength = float(raw_strength)
        except ValueError:
            sys.exit(f"herdr-theme: HERDR_SIDEBAR_TINT_STRENGTH must be a number, got {raw_strength!r}")
        if not 0.0 <= strength <= 1.0:
            sys.exit(f"herdr-theme: HERDR_SIDEBAR_TINT_STRENGTH must be in [0, 1], got {strength}")
    else:
        strength = SIDEBAR_TINT_STRENGTH
    return mix(base, hue, strength)

# herdr's CustomThemeColors fields, in declaration order.
#
# active_row_bg and selection_bg were added after the original 17: they are in
# the config reference and present in the 0.9.1-preview binary. Omitting them
# left the active Space / focused Agent row falling back to the BUILT-IN theme
# instead of our derived surfaces, which is why the active-row cue did not
# track the rest of the palette.
TOKENS = [
    "accent", "panel_bg", "sidebar_bg", "active_row_bg", "selection_bg",
    "surface0", "surface1", "surface_dim",
    "overlay0", "overlay1", "text", "subtext0", "mauve", "green",
    "yellow", "red", "blue", "teal", "peach",
]

BEGIN = "# >>> kitty-sync >>>"
END = "# <<< kitty-sync <<<"


def build_palette(mode):
    """Map kitty color roles onto herdr's token names."""
    k = load_kitty_theme(mode, "herdr-theme")
    required = ["background", "foreground", "active_border_color"]
    missing = [r for r in required if r not in k]
    if missing:
        sys.exit(f"herdr-theme: {mode} theme missing required keys: {', '.join(missing)}")

    def c(name, fallback):
        return k.get(name, k.get(fallback, "#808080"))

    bg, fg = k["background"], k["foreground"]

    # Surfaces and muted text are DERIVED from a bg->fg blend at fixed contrast
    # targets, not taken from kitty's ANSI palette. ANSI color8/color0 sit at
    # ~1.2:1 on this background -- unreadable. See at_contrast().
    #
    #   surface0/1  panel fills + the active-row highlight. surface1 must stay
    #               distinctly brighter than surface0 or the selected workspace
    #               is impossible to pick out.
    #   overlay0    dimmest text that still has to be READ (WCAG AA = 4.5:1).
    #   subtext0    secondary text; sits between overlay1 and text.
    #
    # subtext0's target is clamped so it can't collide with text on themes
    # whose foreground contrast is modest (the light theme's fg is only 8:1).
    fg_cr = contrast(fg, bg)
    sub_target = min(8.0, fg_cr * 0.75)

    # accent is kitty's active-border color, but herdr also draws it as TEXT.
    # On the light theme that pink is only 3.62:1 -- fine for a 1px border,
    # under AA for a label -- so darken toward the foreground just enough to
    # clear 4.5:1. Hue is preserved; on the dark theme this is a no-op.
    def legible(color):
        """WCAG-AA (4.5:1) nudge against this theme's bg/fg. See kitty_colors."""
        return _legible(color, bg, fg)

    # accent is also the ACTIVE pane border, and that is the main focus cue.
    # `legible` only guarantees 4.5:1 (AA for text), which on the light theme
    # left the pink at 4.54 against an inactive border of 1.91 -- a 2.4x split,
    # versus 8x on dark, so the focused pane barely stood out. Push it further
    # for the border role. Hue is preserved; the dark theme's yellow already
    # measures 15.4:1 so this is a no-op there.
    # 4.5 = WCAG AA, the same floor `legible` uses. Deliberately NOT higher:
    # the light theme's authored pink oklch(0.65537 0.25769 358.383) -> #db2587
    # measures 4.54:1 and so passes through untouched, which is what we want --
    # it is the colour chosen in the kitty theme. An earlier 6.5 floor darkened
    # it to #b80058 for a wider active/inactive split, but that overrode the
    # authored hue. The focus cue instead comes mostly from surface1 being
    # dimmed to 1.55, which still leaves a 2.9x split on light and 9.8x on dark.
    ACTIVE_MIN = 4.5
    src_hex, src_raw, _role = _accent_source(k, mode)
    # An explicit ACCENT_TINT still wins, but it is now an override on top of a
    # working kitty inherit rather than the only way to get a coloured accent.
    # When it replaces the colour, src_raw no longer describes the value, so
    # drop it and let deepen() fall back to blending.
    tinted = _tinted_accent(src_hex)
    if tinted != src_hex:
        src_raw = ""
    accent = deepen(legible(tinted), src_raw, bg, fg, ACTIVE_MIN)

    # active_row_bg is the active Space / focused Agent row. It is the same
    # role surface1 already fills for panes, so it reuses that exact value --
    # one visual language for "this is the focused thing" across sidebar and
    # split panes.
    active_row_bg = _tinted_surface(at_contrast(bg, fg, 1.55), bg, accent)
    # selection_bg is only the Navigate-mode cursor row, which sits ON the
    # sidebar and moves while the active row stays put. Deliberately quieter
    # than active_row_bg (surface0's 1.25 vs 1.55) and untinted, so a transient
    # cursor never outshouts the real selection.
    selection_bg = at_contrast(bg, fg, 1.25)

    return {
        "accent":        accent,
        "active_row_bg": active_row_bg,
        "selection_bg":  selection_bg,
        "panel_bg":    bg,
        # sidebar_bg: recessed relative to the panel so the spaces list reads as
        # chrome rather than content. On dark that means slightly lighter than
        # the near-black bg (pure-black-on-black is invisible); on light,
        # slightly darker than white. Kept below surface0 so an active row still
        # lifts off it.
        #
        # 1.15, not 1.06. The dark theme's bg is oklch L=0.226 (#1c1c1c), so a
        # 1.06 target left the sidebar at #222222 -- 1.07:1 against the panel,
        # which reads as one flat black slab with no visible divider. 1.15 gives
        # #282828 (1.16:1): still clearly chrome, but the edge is findable.
        # Do not raise this to 1.25 -- that resolves to #2e2e2e on dark, exactly
        # surface0, and the active row would stop lifting off the sidebar.
        "sidebar_bg":  _tinted_sidebar(at_contrast(bg, fg, 1.15), accent),
        "surface0":    at_contrast(bg, fg, 1.25),
        # surface1 doubles as the INACTIVE pane border. Held deliberately low so
        # the gap to `accent` (the active border) is wide: at 1.9 the light
        # theme separated active from inactive by only 2.4x, versus 8x on dark,
        # which made the focused pane hard to spot. See ACTIVE_MIN below.
        "surface1":    _tinted_surface(at_contrast(bg, fg, 1.55), bg, accent),
        "surface_dim": at_contrast(bg, fg, 1.08),
        "overlay0":    at_contrast(bg, fg, 4.5),
        "overlay1":    at_contrast(bg, fg, 6.0),
        "text":        fg,
        "subtext0":    at_contrast(bg, fg, sub_target),
        "mauve":       legible(c("color5", "color13")),
        "green":       legible(c("color2", "color10")),
        "yellow":      legible(c("color3", "color11")),
        "red":         legible(c("color1", "color9")),
        "blue":        legible(c("color4", "color12")),
        "teal":        legible(c("color6", "color14")),
        "peach":       legible(c("color11", "color3")),
    }


def render_block(palettes):
    lines = [
        BEGIN,
        "# Generated by herdr-theme from kitty themes/theme-{light,dark}.conf -- do not hand-edit.",
        "# Regenerate:  kitty-config/herdr-theme",
    ]
    for mode in ("light", "dark"):
        lines += ["", f"[theme.custom.{mode}]"]
        lines += [f'{t} = "{palettes[mode][t]}"' for t in TOKENS]
    lines.append(END)
    return "\n".join(lines)


def configure_theme(text):
    """Normalize [theme] so the generated mode tables are actually selected."""
    match = re.search(r"(?ms)^\[theme\]\s*\n(.*?)(?=^\[|\Z)", text)
    if not match:
        prefix = (
            '[theme]\nname = "terminal"\nauto_switch = true\n'
            'light_name = "terminal"\ndark_name = "terminal"\n\n'
        )
        return prefix + text

    body = match.group(1)
    desired = {
        "name": '"terminal"',
        "auto_switch": "true",
        "light_name": '"terminal"',
        "dark_name": '"terminal"',
    }
    for key, value in desired.items():
        pattern = re.compile(rf"(?m)^(\s*{key}\s*=\s*).*$")
        if pattern.search(body):
            body = pattern.sub(rf"\g<1>{value}", body, count=1)
        else:
            body += f'{key} = {value}\n'
    return text[:match.start(1)] + body + text[match.end(1):]


def apply(config_path, palettes, do_print):
    block = render_block(palettes)
    if do_print:
        print(block)
        return False

    if not os.path.exists(config_path):
        sys.exit(f"herdr-theme: no config at {config_path}")
    text = open(config_path, encoding="utf-8").read()
    text = configure_theme(text)

    # Replace our managed block if present, else append it.
    pattern = re.compile(
        re.escape(BEGIN) + r".*?" + re.escape(END), re.S
    )
    if pattern.search(text):
        new = pattern.sub(lambda _: block, text)
    else:
        # Guard: unmanaged mode-specific custom tables would collide with ours.
        if re.search(r"^\s*\[theme\.custom\.(?:light|dark)\]", text, re.M):
            sys.exit(
                "herdr-theme: config.toml already has a hand-written mode-specific custom theme.\n"
                "Remove or comment it out first -- refusing to create a duplicate section."
            )
        new = text.rstrip("\n") + "\n\n" + block + "\n"

    if new == text:
        return False
    tmp = config_path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(new)
    os.replace(tmp, config_path)
    return True


def main():
    ap = argparse.ArgumentParser()
    # Kept as an optional compatibility argument because sync-theme historically
    # called `herdr-theme light|dark`. Both palettes are now always generated.
    ap.add_argument("mode", nargs="?", choices=["dark", "light"])
    ap.add_argument("--config",
                    default=os.path.expanduser("~/.config/herdr/config.toml"))
    ap.add_argument("--print", dest="do_print", action="store_true",
                    help="print the block instead of writing it")
    args = ap.parse_args()

    palettes = {mode: build_palette(mode) for mode in ("light", "dark")}
    changed = apply(args.config, palettes, args.do_print)
    if changed:
        print("herdr-theme: applied light/dark palettes")


if __name__ == "__main__":
    main()
