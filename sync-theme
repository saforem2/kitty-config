#!/bin/zsh

kitty_dir="${0:a:h}"
theme="$kitty_dir/theme.conf"

# Directory of THIS script with symlinks resolved (:A, not :a). Hammerspoon
# invokes us as ~/.config/kitty/sync-theme, which is a symlink into the
# kitty-config repo; :a would leave kitty_dir at ~/.config/kitty, where the
# sibling helper scripts do not exist. kitty_dir itself deliberately stays
# unresolved, since theme.conf and themes/ are addressed through ~/.config/kitty.
script_dir="${0:A:h}"

if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = "Dark" ]]; then
    target="$kitty_dir/themes/theme-dark.conf"
    spot_scheme="KittyDark"
    mode="dark"
else
    target="$kitty_dir/themes/theme-light.conf"
    spot_scheme="KittyLight"
    mode="light"
fi

rm -rf "$theme"
ln -s "$target" "$theme"

# Reload every running kitty instance.
#
# NOTE: `kill -SIGUSR1` only re-reads the config; on kitty 0.47 it does NOT
# re-apply the color scheme to already-open windows (that's why a manual
# `cmd+shift+,` used to be needed afterwards). The remote-control
# `kitty @ load-config` DOES repaint live, which is what we want.
#
# We target each instance's control socket directly. `listen_on` is set to
# `unix:/tmp/kitty-{kitty_pid}` in kitty.conf, so sockets are `/tmp/kitty-<pid>`.
kitty_bin="/Applications/kitty.app/Contents/MacOS/kitty"
for sock in /tmp/kitty-*(=N); do
    "$kitty_bin" @ --to "unix:$sock" load-config >/dev/null 2>&1
done

# Mirror the kitty palette into herdr's [theme.custom] block and hot-reload it.
#
# herdr's own theme.auto_switch only picks between built-in themes, so matching
# these colors means rewriting the custom block per mode. herdr-theme edits only
# its own marker-delimited section, leaving keybindings and plugin config alone.
# Both steps are best-effort: a missing herdr must not break the kitty switch.
#
# Resolve herdr by absolute path, NOT via `command -v`. Hammerspoon triggers
# this script with os.execute, whose PATH is only /usr/bin:/bin:/usr/sbin:/sbin
# -- so a PATH lookup silently fails and the whole block gets skipped on every
# real appearance change, while working fine when run by hand from a shell.
herdr_bin=""
for candidate in "$HOME/.local/bin/herdr" /opt/homebrew/bin/herdr /usr/local/bin/herdr; do
    [[ -x "$candidate" ]] && { herdr_bin="$candidate"; break }
done
[[ -z "$herdr_bin" ]] && herdr_bin="$(command -v herdr 2>/dev/null)"

if [[ -n "$herdr_bin" && -f "$HOME/.config/herdr/config.toml" ]]; then
    if "$script_dir/herdr-theme" "$mode" >/dev/null 2>&1; then
        "$herdr_bin" server reload-config >/dev/null 2>&1
    fi
fi

# Mirror the kitty palette into spotatui's `theme:` block.
#
# Like herdr (and unlike leaf), the palette is REGENERATED from the kitty theme
# on every switch, so editing a kitty color follows through automatically.
#
# Two spotatui quirks the generator handles, worth knowing about here: it has no
# reload channel, so a running instance keeps its old colors until restarted;
# and its own save_config() rewrites config.yml wholesale from memory, so a live
# instance can erase what we just wrote. spotatui-theme prints a warning to
# stderr when it sees a running player -- let that through rather than
# swallowing it, since a silently reverted theme is otherwise baffling.
spotatui_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/spotatui/config.yml"
if [[ -f "$spotatui_cfg" ]]; then
    "$script_dir/spotatui-theme" "$mode" --config "$spotatui_cfg" || \
        print -u2 "sync-theme: spotatui-theme $mode failed; leaving its theme alone"
fi

# Keep the spicetify (Spotify) termspot theme in sync with the system appearance.
# Only re-apply when the scheme actually changed, since `spicetify apply` reloads
# the Spotify client. Backgrounded so kitty's reload above stays instant.
if command -v spicetify >/dev/null 2>&1; then
    spot_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/spicetify/config-xpui.ini"
    current="$(grep -E '^color_scheme' "$spot_cfg" 2>/dev/null | awk -F= '{ gsub(/ /,"",$2); print $2 }')"
    if [[ "$current" != "$spot_scheme" ]]; then
        ( spicetify config color_scheme "$spot_scheme" && spicetify apply ) >/dev/null 2>&1 &
    fi
fi
# Mirror the palette into nom (RSS TUI).
#
# Unlike leaf above, nom has no symlink or include indirection -- config.yml is
# one flat file holding the theme AND the whole feed list -- so nom-theme edits
# the `theme:` mapping in place and leaves everything else byte for byte.
# `glamour: auto` handles the article body on its own; only the three TUI
# colours need rewriting.
#
# Best-effort like the blocks above: nom being absent must not break the switch.
# No reload channel and nom is short-lived, so already-open instances keep
# their colours -- the next launch picks these up.
if [[ -f "$HOME/Library/Application Support/nom/config.yml" ]]; then
    "$script_dir/nom-theme" "$mode" >/dev/null 2>&1 || true
fi

