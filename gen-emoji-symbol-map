#!/usr/bin/env zsh
# Regenerate the emoji symbol_map line in kitty.conf.
#
# WHY THIS EXISTS: Apple Color Emoji's metrics are too tall for a cell sized by
# Iosevka Condensed (at font_size 14: ascent 17.5 + descent 5.5 = 23px into an
# 18px cell), so emoji render clipped top and bottom. kitty cannot scale a
# fallback font independently -- there is no per-symbol_map size and no
# per-font font_size -- so the fix is to route emoji to Noto Color Emoji,
# whose metrics fit.
#
# WHY IT IS GENERATED: hand-picking Unicode blocks does not work. U+2600-U+27BF
# is mixed -- real emoji (U+2705 checkmark, U+274C cross, U+26A1 high voltage,
# U+2728 sparkles) sit right beside text symbols (U+276F angle quote, U+2713
# check) that Nerd Font prompts and TUIs draw with. Mapping the whole block
# breaks the symbols; skipping it leaves those emoji clipped. Querying
# Unicode's own Emoji_Presentation property splits them exactly.
#
#   ./gen-emoji-symbol-map
set -euo pipefail
cd "${0:a:h}"

ranges=$(kitty +runpy '
from kitty.fast_data_types import char_props_for
hits=[]
for cp in list(range(0x2000,0x3300)) + list(range(0x1F000,0x1FBFF)):
    try: q = char_props_for(chr(cp))
    except Exception: continue
    # width==2 is the bulk (real emoji). width==1 emoji are TEXT-DEFAULT chars
    # that render as emoji only with variation selector U+FE0F -- e.g. warning
    # U+26A0, stopwatch U+23F1. Apple Color Emoji supplies those too, and they
    # clipped just like the width-2 ones, so both widths must be mapped.
    #
    # For width-1, only take codepoints at U+1F000 and above. Everything below
    # that in the width-1 set is a dual-purpose BMP symbol that TUIs draw as
    # plain TEXT: media-control glyphs (U+23E9-U+23FA -- pause, stop, and the
    # record circle U+23FA that Claude Code uses for tool markers), geometric
    # shapes (U+25AA-U+25FC), dingbats (U+2714 heavy check, U+2716 heavy X),
    # and arrows (U+27A1, U+2B05-U+2B07). Routing those to a colour emoji font
    # turns terminal UI chrome into pictures.
    #
    # Two exceptions are allowed back in: warning U+26A0 and stopwatch U+23F1
    # are used as genuine emoji in CLI output (they were the reported clipping
    # cases) and have no competing text role here.
    TEXT_ALLOW = {0x26A0, 0x23F1}
    w = q.get("width")
    if q.get("is_emoji") and q.get("is_emoji_presentation_base") and (
            w == 2 or (w == 1 and (cp >= 0x1F000 or cp in TEXT_ALLOW))):
        hits.append(cp)
out=[]
for x in hits:
    if out and x==out[-1][1]+1: out[-1][1]=x
    else: out.append([x,x])
print(",".join(f"U+{a:04X}-U+{b:04X}" if a!=b else f"U+{a:04X}" for a,b in out))
' | tail -1)

[[ $ranges == U+* ]] || { print -u2 "ERROR: bad range output: ${ranges:0:60}"; exit 1; }

python3 - "$ranges" <<'PY'
import sys
r = sys.argv[1].strip()
p = "kitty.conf"
lines = open(p).read().split("\n")
idx = [i for i, l in enumerate(lines) if l.startswith("symbol_map ") and "Noto Color Emoji" in l]
if len(idx) != 1:
    raise SystemExit(f"ERROR: expected exactly 1 emoji symbol_map line, found {len(idx)}")
lines[idx[0]] = "symbol_map " + r + " Noto Color Emoji"
open(p, "w").write("\n".join(lines))
print(f"symbol_map updated: {r.count(',')+1} ranges")
PY

# Sanity: text symbols must NOT be inside the mapped set.
kitty +runpy '
from kitty.fast_data_types import char_props_for
# Guard the FULL set of glyphs terminal UIs draw as text: prompt chars, box
# drawing, media controls (incl. U+23FA record, used for tool markers), heavy
# dingbats and black arrows. Any of these landing in the map means colour
# pictures in place of UI chrome.
import os, re
_cfg = os.path.expanduser("~/.config/kitty/kitty.conf")
_line = [l for l in open(_cfg) if l.startswith("symbol_map ") and "Noto" in l][0]
_rs = []
for _t in _line.split()[1].split(","):
    if "-" in _t:
        _a, _b = _t.split("-"); _rs.append((int(_a[2:], 16), int(_b[2:], 16)))
    else:
        _v = int(_t[2:], 16); _rs.append((_v, _v))
bad = [c for c in "❯✓✔✖→●○│─┌┐└┘⏺⏸⏹▪▫➡⬅⬆⬇"
       if any(a <= ord(c) <= b for a, b in _rs)]
print("ERROR: text symbols captured: "+repr(bad) if bad else "verified: text symbols excluded")
'
